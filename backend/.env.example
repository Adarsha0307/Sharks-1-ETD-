NODE_ENV=sandbox
PORT=8080
DATABASE_URL=postgresql://etd_app:replace-with-test-only-password@postgres:5432/etd
EVIDENCE_ROOT=/var/lib/etd/evidence
ALLOWED_ORIGIN=http://127.0.0.1:8080
SESSION_COOKIE_NAME=etd_session
SESSION_TTL_MINUTES=480
COOKIE_SECURE=false
TRUST_PROXY=false
JSON_BODY_LIMIT=64kb
UPLOAD_MAX_BYTES=10485760
DECODED_MAX_BYTES=26214400
MAX_ATTACHMENTS=25
MAX_URLS=200
MAX_MIME_DEPTH=20
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
WORKER_POLL_MS=1000
PARSE_TIMEOUT_MS=15000
ML_URL=http://ml:8000
ML_TIMEOUT_MS=3000
MODEL_MANIFEST_PATH=/models/model-manifest.json
DNS_FIXTURE_PATH=/app/fixtures/dns.json
PROTECTED_DOMAINS=example.edu
PROTECTED_ORGANIZATIONS=Example University
AUTHORIZED_SENDERS=notifications.vendor.example:example.edu
